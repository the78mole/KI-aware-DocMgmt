# OpenBao-Zugang fuer dieses Repo — nach .env kopieren (chmod 600), Token eintragen.
# Token erzeugen (mit privilegiertem Token, ausserhalb von ~/GIT):
#   bao token create -namespace=it-infra -policy=it-infra-read -period=87600h \
#     -display-name=ki-aware-docmgmt
BAO_ADDR=https://openbao.intern.chaintronics.com/
BAO_NAMESPACE=it-infra
BAO_TOKEN=
