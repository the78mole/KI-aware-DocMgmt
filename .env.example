# Lokale Konfiguration — nach .env kopieren (chmod 600). docker compose und direnv lesen sie automatisch.
# Für den Compose-Stack reicht `./scripts/dev-secrets.sh`, das die Secrets unten zufällig erzeugt.

# --- Compose-Stack ---
POSTGRES_PASSWORD=
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# DOCMGMT_PORT=8000
# MARKER_IMAGE_TAG=2.0.0
# MARKER_URL=http://marker:8001

# --- Backend ohne Compose (uv run fastapi dev …) ---
# DATABASE_URL=postgresql+psycopg://docmgmt:<passwort>@127.0.0.1:5432/docmgmt
# S3_ENDPOINT_URL=http://127.0.0.1:3900

# --- Optional: Secrets aus OpenBao/Vault (KV v2) statt aus Umgebungsvariablen ---
# Aktiv nur, wenn BAO_SECRET_PATH gesetzt ist. Schlüssel heißen wie die Einstellungen (s3_secret_access_key, …).
# BAO_ADDR=https://openbao.example.com/
# BAO_NAMESPACE=
# BAO_TOKEN=
# BAO_SECRET_PATH=secret/ki-aware-docmgmt
