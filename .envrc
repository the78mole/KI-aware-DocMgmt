# direnv: laedt .env mit einem scoped OpenBao-Token fuer Namespace "it-infra".
#
# Das hier gesetzte BAO_TOKEN sticht das Root-Token in ~/.vault-token und
# ersetzt zugleich den Sperr-Riegel aus ~/GIT/.envrc. Bewusst KEIN source_up:
# der Riegel wuerde das Repo-Token sonst wieder ueberschreiben.
#
# Rechte: nur lesen (Policy it-infra-read)

dotenv_if_exists

printenv BAO_TOKEN >/dev/null || log_error "BAO_TOKEN fehlt — .env unvollstaendig oder nicht lesbar"
log_status "OpenBao: Namespace $BAO_NAMESPACE — nur lesend (it-infra-read)"
