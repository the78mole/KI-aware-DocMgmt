# direnv: lädt die lokale .env (gitignored, mode 600), falls vorhanden.
#
# Bewusst KEIN source_up: Ein übergeordnetes .envrc (z. B. ein Sperr-Riegel für BAO_TOKEN)
# würde sonst Werte aus dieser .env wieder überschreiben.

dotenv_if_exists

if [ -n "${BAO_TOKEN:-}" ]; then
  log_status "OpenBao: ${BAO_ADDR:-?}${BAO_NAMESPACE:+ (Namespace $BAO_NAMESPACE)}"
else
  # Ohne eigenes Token nicht auf ein globales (~/.vault-token) zurückfallen
  export BAO_TOKEN=disabled-no-repo-token
fi
